body,
html {
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.ssw-admin-wrap {
    max-width: 1280px;
    padding: 24px 12px 60px;
}

.ssw-plan-box,
.ssw-form-box,
.ssw-license-box,
.ssw-site-list-box {
    background: #fff;
    border: 1px solid #dfe3ea;
    border-radius: 12px;
    padding: 20px;
    margin: 24px 0;
    box-shadow: 0 4px 18px rgba(16, 42, 67, 0.04);
}

.ssw-template-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
    margin-top: 30px;
}

.ssw-template-card {
    background: #fff;
    border: 1px solid #dfe3ea;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 360px;
}

.ssw-template-preview {
    position: relative;
    min-height: 150px;
    background: linear-gradient(135deg, #102a43, #2563eb);
}

.ssw-preview-local-business { background: linear-gradient(135deg, #1d4ed8, #93c5fd); }
.ssw-preview-corporate { background: linear-gradient(135deg, #102a43, #2563eb); }
.ssw-preview-hotel { background: linear-gradient(135deg, #222222, #b89555); }
.ssw-preview-fashion { background: linear-gradient(135deg, #151515, #a45d5d); }
.ssw-preview-real-estate { background: linear-gradient(135deg, #16324f, #d8c3a5); }
.ssw-preview-beauty { background: linear-gradient(135deg, #493c35, #c98f8f); }
.ssw-preview-restaurant { background: linear-gradient(135deg, #233a2d, #c66a3d); }
.ssw-preview-clinic { background: linear-gradient(135deg, #174a67, #2b7a78); }

.ssw-card-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.03em;
}

.ssw-template-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    flex: 1;
}

.ssw-template-content h3 {
    margin: 0;
    font-size: 22px;
}

.ssw-template-content p {
    margin: 0;
    color: #4b5563;
    line-height: 1.6;
}

.ssw-template-meta {
    color: #2563eb;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

.ssw-create-site-button {
    margin-top: auto;
    width: 100%;
    justify-content: center;
}

.ssw-result-box {
    display: none;
    padding: 16px 18px;
    border-radius: 12px;
    margin-top: 20px;
    font-weight: 600;
}

.ssw-result-box.success {
    display: block;
    background: #ecfdf5;
    border: 1px solid #34d399;
    color: #065f46;
}

.ssw-result-box.error {
    display: block;
    background: #fef2f2;
    border: 1px solid #fca5a5;
    color: #991b1b;
}

.ssw-site-list-box table {
    width: 100%;
    border-collapse: collapse;
}

.ssw-site-list-box th,
.ssw-site-list-box td {
    border-bottom: 1px solid #e5e7eb;
    padding: 12px 10px;
    text-align: left;
    vertical-align: top;
}

.ssw-button,
.ssw-button-secondary {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    transition: 0.2s ease;
}

.ssw-button {
    background: #2563eb;
    color: #fff;
}

.ssw-button:hover {
    background: #1d4ed8;
    color: #fff;
}

.ssw-button-secondary {
    background: transparent;
    color: #102a43;
    border: 1px solid #9aa9b8;
}

.ssw-template .ssw-template {
    margin-bottom: 32px;
}

.ssw-template body {
    background: #f8fafc;
}

.ssw-corporate .ssw-button {
    background: #2563eb;
}

.ssw-hotel .ssw-button {
    background: #b89555;
}

.ssw-fashion .ssw-button {
    background: #a45d5d;
}

.ssw-real-estate .ssw-button {
    background: #16324f;
}

.ssw-beauty .ssw-button {
    background: #c98f8f;
}

.ssw-restaurant .ssw-button {
    background: #c66a3d;
}

.ssw-clinic .ssw-button {
    background: #2b7a78;
}

@media (max-width: 782px) {
    .ssw-template-grid {
        grid-template-columns: 1fr;
    }

    .ssw-admin-wrap {
        padding: 12px;
    }
}

